  "dataList": [
    {
      "id": "0",
      "content": "<color=#293B95>그림자를 쫓던 나날들</color>"
    },
    {
      "id": "1",
      "content": "<color=#293B95>남은 건 허망한 기억</color>"
    },
    {
      "id": "2",
      "content": "<color=#293B95>불길이 나를 태운 것처럼</color>"
    },
    {
      "id": "3",
      "content": "<color=#293B95>내 손엔 잿빛 먼지 뿐</color>"
    },
    {
      "id": "4",
      "content": "<color=#293B95>쉼 없이 달려 왔던</color>"
    },
    {
      "id": "5",
      "content": "<color=#293B95>나를 죄여오던 시간들</color>"
    },
    {
      "id": "6",
      "content": "<color=#293B95>이조차 그리워질까</color>"
    },
    {
      "id": "7",
      "content": "<color=#293B95>먼 훗날 언젠가는</color>"
    },
    {
      "id": "8",
      "content": "<color=#293B95>돌이켜 볼 기억 속에</color>"
    },
    {
      "id": "9",
      "content": "<color=#293B95>미소 지을 수 있기를</color>"
    },
    {
      "id": "10",
      "content": "<color=#293B95>내게 남은 알 수 없는 시간과</color>"
    },
    {
      "id": "11",
      "content": "<color=#293B95>이제는 나아가야 할 때</color>"
    },
    {
      "id": "12",
      "content": "<color=#293B95>자신을 태워 사라져 가는</color>"
    },
    {
      "id": "13",
      "content": "<color=#293B95>촛불과 닮아 있구나</color>"
    },
    {
      "id": "14",
      "content": "<color=#293B95>숨 고를 새도 없이</color>"
    },
    {
      "id": "15",
      "content": "<color=#293B95>떠밀려 던져진 날 속에</color>"
    },
    {
      "id": "16",
      "content": "<color=#293B95>내 길을 갈 수 있기를</color>"
    },
    {
      "id": "17",
      "content": "<color=#293B95>먼 훗날 언젠가는</color>"
    },
    {
      "id": "18",
      "content": "<color=#293B95>돌이켜 볼 기억 속에</color>"
    },
    {
      "id": "19",
      "content": "<color=#293B95>미소 지을 수 있도록</color>"
    },
    {
      "id": "20",
      "content": "<color=#293B95>멀리 멀리 날아가고 싶어</color>"
    },
    {
      "id": "21",
      "content": "<color=#293B95>밤 하늘의 새처럼 별에 닿을 수 있게</color>"
    },
    {
      "id": "22",
      "content": "<color=#293B95>이밤 이밤 또 다시 찾아오겠지만</color>"
    },
    {
      "id": "23",
      "content": "<color=#293B95>괜찮아 다 살아지네</color>"
    },
    {
      "id": "24",
      "content": "<color=#293B95>괜찮아</color>"
    }
   
  ]
