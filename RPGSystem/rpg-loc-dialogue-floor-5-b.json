      ]
    },
    {
      "key": "D5025M",
      "texts": [
        { "index": 0, "text": "…….", "speaker": "뫼르소" }
      ]
    },
    {
      "key": "D5025N",
      "texts": [
        { "index": 0, "text": "예, 아마도 높은 확률로 그러할 것입니다.", "speaker": "뫼르소" }
      ]
    },
    {
      "key": "D5025O",
      "texts": [
        { "index": 0, "text": "하지만… 중요한 것은…", "speaker": "뫼르소" }
